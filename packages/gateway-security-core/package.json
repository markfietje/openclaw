{
  "name": "@openclaw/gateway-security-core",
  "version": "0.0.0-private",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.mts",
      "import": "./dist/capabilities.mjs",
      "default": "./dist/capabilities.mjs"
    },
    "./device-session-authority": {
      "types": "./dist/device-session-authority.d.mts",
      "import": "./dist/device-session-authority.mjs",
      "default": "./dist/device-session-authority.mjs"
    },
    "./ip-restriction-policy": {
      "types": "./dist/ip-restriction-policy.d.mts",
      "import": "./dist/ip-restriction-policy.mjs",
      "default": "./dist/ip-restriction-policy.mjs"
    }
  },
  "dependencies": {
    "@openclaw/net-policy": "workspace:*"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/capabilities.ts src/device-session-authority.ts src/ip-restriction-policy.ts --no-config --platform node --format esm --dts --out-dir dist --clean"
  }
}
